# meowquest 本地开发环境配置（复制为 .env 填真实值；.env 已被 gitignore）
# 线上不使用此文件（systemd EnvironmentFile /etc/meowquest.env）

# 数据库（二选一：PG 优先）
MEOW_PG_DSN=host=127.0.0.1 port=5433 user=meow dbname=meowquest sslmode=disable
# MEOW_MYSQL_DSN=root:@tcp(127.0.0.1:3306)/meowquest?parseTime=true&charset=utf8mb4&loc=Local

# LLM（qwen3.5-flash 聊天 + filetrans 语音转写）
MEOW_LLM_API_KEY=sk-xxx
# MEOW_LLM_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
# MEOW_LLM_MODEL=qwen3.5-flash

# 服务
MEOW_ADDR=127.0.0.1:8600

# 语音识别需要（音频临时 URL 的公网前缀；本地开发无公网时可留空=ASR 不可用）
# MEOW_PUBLIC_URL=https://your-domain
